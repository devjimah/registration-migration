{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["jquery"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Migration mode: JS and TS live side by side. Remaining .js files are
    // bundled but not type-checked; flip checkJs on to tighten further.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
